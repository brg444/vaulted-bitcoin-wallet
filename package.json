{
  "name": "vaulted-bitcoin-wallet",
  "version": "0.1.0",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "@arkade-os/sdk": "file:vendor/arkade-os-sdk.tgz",
    "@arkade-os/solver-discovery": "0.2.3",
    "@arkade-os/swap": "0.0.10",
    "@fontsource-variable/geist": "^5.2.8",
    "@ngraveio/bc-ur": "1.1.13",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@scure/base": "2.0.0",
    "@scure/bip32": "2.0.1",
    "@scure/btc-signer": "2.0.1",
    "@vercel/blob": "^2.8.0",
    "buffer": "^6.0.3",
    "cborg": "^6.1.2",
    "decimal.js": "^10.5.0",
    "light-bolt11-decoder": "3.2.0",
    "lucide-react": "^0.575.0",
    "nostr-tools": "2.17.2",
    "process": "0.11.10",
    "qr": "^0.5.2",
    "qr-scanner": "^1.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "web-haptics": "0.0.6"
  },
  "scripts": {
    "prepare": "husky install",
    "build:worker": "vite build -c vite.worker.config.ts",
    "start": "VITE_VAULT_RELEASE_NETWORK=mutinynet pnpm build:worker && vite --port 3003 --host localhost",
    "recover:local": "bun tools/offline-recovery/serve.ts",
    "build": "pnpm build:worker && vite build",
    "build:mainnet": "VITE_VAULT_RELEASE_NETWORK=mainnet VITE_VAULT_LIGHTNING_SEND=true pnpm build",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:mainnet-pins": "node scripts/verify-mainnet-pins.mjs",
    "test": "vitest run",
    "test:ui": "vitest run --ui",
    "test:unit": "vitest run --exclude '**/e2e/**'",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/prepare-browser-tests.mjs && playwright test -c playwright.vault.config.ts",
    "test:visual": "node scripts/prepare-browser-tests.mjs && playwright test -c playwright.visual.config.ts",
    "test:e2e:ui": "node scripts/prepare-browser-tests.mjs && playwright test -c playwright.vault.config.ts --ui",
    "test:codegen": "playwright codegen localhost:3003",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "build:mutinynet": "VITE_VAULT_RELEASE_NETWORK=mutinynet pnpm build",
    "test:recovery-browser": "node tools/program-emergency/build.mjs && node tools/program-emergency/browser.test.cjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.1.0",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^8.57.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "^8.0.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^3.2.4",
    "vitest-fetch-mock": "^0.4.5"
  },
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0",
    "pnpm": ">=8"
  },
  "pnpm": {
    "overrides": {
      "@arkade-os/sdk": "file:vendor/arkade-os-sdk.tgz",
      "@arkade-os/swap>@arkade-os/sdk": "file:vendor/arkade-os-sdk.tgz",
      "ws": "8.21.0"
    },
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}

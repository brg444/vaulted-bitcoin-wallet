{
  "buildCommand": "pnpm build:mainnet",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "framework": null,
  "env": {
    "VAULT_RELEASE_NETWORK": "mainnet",
    "VITE_VAULT_RELEASE_NETWORK": "mainnet",
    "VITE_VAULT_LIGHTNING_SEND": "true"
  },
  "headers": [
    { "source": "/release.json", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    {
      "source": "/vault-wallet-service-worker.mjs",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://arkade.computer https://mempool.arkade.sh wss://mempool.arkade.sh https://blockchain.info wss://nostr.arkade.sh; worker-src 'self'"
        },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/health", "destination": "/api/gateway?route=health" },
    { "source": "/ready", "destination": "/api/gateway?route=ready" },
    { "source": "/v1/light/renew/:phase", "destination": "/api/gateway?route=light-renew&phase=:phase" },
    { "source": "/v1/light/enroll/:phase", "destination": "/api/gateway?route=light-enroll&phase=:phase" },
    { "source": "/v1/enroll/session", "destination": "/api/gateway?route=enroll-session" },
    { "source": "/v1/enroll/:action", "destination": "/api/v1/enroll/:action" },
    { "source": "/v1/passkey/:action", "destination": "/api/v1/passkey/:action" },
    { "source": "/v1/kit", "destination": "/api/kit" },
    { "source": "/v1/vtxo/operation", "destination": "/api/v1/vtxo-operation" },
    { "source": "/v1/vtxo/reserve", "destination": "/api/v1/vtxo-reserve" },
    { "source": "/v1/vtxo/abort", "destination": "/api/v1/vtxo-abort" },
    { "source": "/v1/vtxo/authorize", "destination": "/api/v1/vtxo-authorize" },
    { "source": "/v1/vtxo/checkpoints/authorize", "destination": "/api/v1/vtxo-checkpoints-authorize" },
    { "source": "/v1/vtxo/finalize", "destination": "/api/v1/vtxo-finalize" },
    { "source": "/v1/vtxo/board/:phase", "destination": "/api/gateway?route=board&phase=:phase" },
    { "source": "/v1/:path*", "destination": "/api/v1/:path*" },
    { "source": "/esplora/:path*", "destination": "https://mempool.space/api/:path*" },
    { "source": "/((?!assets/|api/|health(?:/|$)|v1(?:/|$)).*)", "destination": "/index.html" }
  ]
}

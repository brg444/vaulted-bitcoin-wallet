Subject: [PATCH] fix: preserve tree cosigner metadata during signature updates

---
 packages/ts-sdk/src/tree/txTree.ts            |   4 +-
 .../ts-sdk/test/batch-tree-metadata.test.ts   | 106 ++++++++++++++++++
 packages/ts-sdk/test/boarding-adapter.test.ts |  15 +++
 .../fixtures/boarding-tree-transport.json     |  66 +++++++++++
 4 files changed, 190 insertions(+), 1 deletion(-)
 create mode 100644 packages/ts-sdk/test/batch-tree-metadata.test.ts
 create mode 100644 packages/ts-sdk/test/fixtures/boarding-tree-transport.json

diff --git a/packages/ts-sdk/src/tree/txTree.ts b/packages/ts-sdk/src/tree/txTree.ts
index bdb7aac1..0a66b05a 100644
--- a/packages/ts-sdk/src/tree/txTree.ts
+++ b/packages/ts-sdk/src/tree/txTree.ts
@@ -250,6 +250,8 @@ function buildGraph(rootTxid: string, chunksByTxid: Map<string, DecodedNode>): T
 }
 
 function decodeNode(chunk: TxTreeNode): DecodedNode {
-    const tx = Transaction.fromPSBT(base64.decode(chunk.tx));
+    // Signature updates must retain the cosigner and expiry PSBT fields used
+    // to verify the signed recovery tree after settlement events are applied.
+    const tx = Transaction.fromPSBT(base64.decode(chunk.tx), { allowUnknown: true });
     return { tx, children: chunk.children };
 }

--- /dev/null
+++ b/packages/ts-sdk/test/settlement-session.test.ts
@@ -0,0 +1,369 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { base64, hex } from "@scure/base";
+import { Address, OutScript, SigHash } from "@scure/btc-signer";
+import { sha256 } from "@scure/btc-signer/utils.js";
+import { schnorr } from "@noble/secp256k1";
+import {
+    createSettlementSession,
+    DefaultVtxo,
+    SingleKey,
+    Transaction,
+    TxTree,
+    Wallet,
+} from "../src";
+import { CSVMultisigTapscript } from "../src/script/tapscript";
+import { networks } from "../src/networks";
+import type { Contract } from "../src/contracts/types";
+import type { ExtendedVirtualCoin } from "../src/wallet";
+import { SettlementEventType, type ArkInfo, type ArkProvider } from "../src/providers/ark";
+import parent from "./fixtures/settlement-session-parent.json";
+
+afterEach(() => vi.restoreAllMocks());
+
+async function fixture() {
+    const identity = SingleKey.fromHex("01".repeat(32));
+    const operator = SingleKey.fromHex("02".repeat(32));
+    const publicKey = await identity.xOnlyPublicKey();
+    const operatorKey = await operator.xOnlyPublicKey();
+    const script = new DefaultVtxo.Script({
+        pubKey: publicKey,
+        serverPubKey: operatorKey,
+        csvTimelock: { type: "seconds", value: 604672n },
+    });
+    const address = Address(networks.bitcoin).encode({ type: "tr", pubkey: operatorKey });
+    const outputScript = OutScript.encode(Address(networks.bitcoin).decode(address));
+    const checkpoint = (value = 86528n, pubkeys = [operatorKey]) =>
+        hex.encode(
+            CSVMultisigTapscript.encode({ timelock: { type: "seconds", value }, pubkeys }).script,
+        );
+    const info = {
+        network: "bitcoin",
+        forfeitPubkey: hex.encode(await operator.compressedPublicKey()),
+        forfeitAddress: address,
+        checkpointTapscript: checkpoint(),
+        dust: 330n,
+        vtxoTreeExpiry: 604672n,
+    } as ArkInfo;
+    const provider = {
+        getInfo: vi.fn(async () => info),
+        confirmRegistration: vi.fn(async () => {}),
+        submitSignedForfeitTxs: vi.fn(async (_forfeits: string[], _commitment?: string) => {}),
+    };
+    // Deliberately only the account's contract read capability. No repository writer,
+    // indexer, event stream, Wallet or ContractManager is available to construction.
+    const records: Contract[] = [
+        {
+            type: "default",
+            script: hex.encode(script.pkScript),
+            params: { pubKey: hex.encode(publicKey) },
+            address,
+            state: "active",
+            createdAt: 0,
+        },
+    ];
+    const contracts = { getContracts: vi.fn(async () => records) };
+    const unsigned: string[] = [];
+    const realSign = identity.sign.bind(identity);
+    const sign = vi.spyOn(identity, "sign").mockImplementation(async (tx, indexes) => {
+        unsigned.push(base64.encode(tx.toPSBT()));
+        return realSign(tx, indexes);
+    });
+    const coin = (index = 0): ExtendedVirtualCoin => ({
+        txid: (index ? "bb" : "aa").repeat(32),
+        vout: index,
+        value: 10000 + index * 1000,
+        status: { confirmed: true },
+        createdAt: new Date("2026-01-01T00:00:00Z"),
+        script: hex.encode(script.pkScript),
+        isUnrolled: false,
+        isSpent: false,
+        isSwept: false,
+        virtualStatus: { state: "settled" },
+        forfeitTapLeafScript: script.forfeit(),
+        intentTapLeafScript: script.forfeit(),
+        tapTree: script.encode(),
+    });
+    const create = () =>
+        createSettlementSession({
+            identity,
+            contracts,
+            arkProvider: provider as unknown as ArkProvider,
+            network: "bitcoin",
+        });
+    const event = (overrides = {}) => ({
+        type: SettlementEventType.BatchStarted,
+        id: "fixture-batch",
+        intentIdHashes: [hex.encode(sha256(new TextEncoder().encode("fixture-intent")))],
+        batchExpiry: 604672n,
+        ...overrides,
+    });
+    const final = (commitmentTx = parent.forfeit.commitment) => ({
+        type: SettlementEventType.BatchFinalization,
+        id: "fixture-batch",
+        commitmentTx,
+    });
+    const connector = () =>
+        new TxTree(Transaction.fromPSBT(base64.decode(parent.forfeit.connector)));
+    return {
+        create,
+        identity,
+        operator,
+        publicKey,
+        script,
+        outputScript,
+        address,
+        info,
+        checkpoint,
+        provider,
+        contracts,
+        records,
+        sign,
+        unsigned,
+        coin,
+        event,
+        final,
+        connector,
+    };
+}
+
+async function verifySignatures(proof: string, indexes: number[], pubkey: Uint8Array) {
+    const tx = Transaction.fromPSBT(base64.decode(proof));
+    const inputs = Array.from({ length: tx.inputsLength }, (_, i) => tx.getInput(i));
+    for (const index of indexes) {
+        const input = inputs[index];
+        const leaf = input.tapLeafScript![0][1];
+        expect(input.tapScriptSig).toHaveLength(1);
+        const [key, signature] = input.tapScriptSig![0];
+        expect(key.pubKey).toEqual(pubkey);
+        const hashType = input.sighashType ?? SigHash.DEFAULT;
+        const preimage = tx.preimageWitnessV1(
+            index,
+            inputs.map((i) => i.witnessUtxo!.script),
+            hashType,
+            inputs.map((i) => i.witnessUtxo!.amount),
+            undefined,
+            leaf.slice(0, -1),
+            leaf[leaf.length - 1],
+        );
+        expect(await schnorr.verifyAsync(signature.slice(0, 64), preimage, pubkey)).toBe(true);
+    }
+    for (let i = 0; i < inputs.length; i++) {
+        if (!indexes.includes(i)) expect(inputs[i].tapScriptSig).toBeUndefined();
+    }
+}
+
+describe("settlement session parent compatibility", () => {
+    for (const [index, golden] of parent.proofs.entries()) {
+        it(`preserves parent proof ${index + 1}: ${golden.kind}, ${golden.coinCount} inputs`, async () => {
+            const f = await fixture();
+            const operation = await f.create();
+            const coins = Array.from({ length: golden.coinCount }, (_, i) => f.coin(i));
+            const signed =
+                golden.kind === "delete"
+                    ? await operation.makeDeleteIntentSignature(coins, golden.expiry ?? undefined)
+                    : await operation.makeRegisterIntentSignature(
+                          coins,
+                          [
+                              { amount: 6000n, script: f.script.pkScript },
+                              ...Array.from({ length: golden.outputCount! }, (_, i) => ({
+                                  amount: BigInt(1000 + i * 1000),
+                                  script: f.outputScript,
+                              })),
+                          ],
+                          Array.from({ length: golden.outputCount! }, (_, i) => i + 1),
+                          [hex.encode(await f.operator.compressedPublicKey())],
+                          1789271000.9,
+                          1789271600.9,
+                      );
+            expect(signed.message).toEqual(golden.message);
+            expect(f.unsigned).toEqual([golden.unsignedProof]);
+            const indexes = golden.jobs.map((job) => job.index);
+            expect(f.sign.mock.calls[0][1]).toEqual(indexes);
+            expect(f.contracts.getContracts).toHaveBeenCalledExactlyOnceWith({
+                script: [...new Set(golden.jobs.map((job) => job.lookupScript))],
+            });
+            await verifySignatures(signed.proof, indexes, f.publicKey);
